From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cole Mickens <cole.mickens@gmail.com>
Date: Mon, 21 Mar 2022 00:30:15 -0700
Subject: [PATCH] dtb fixups

---
 .../boot/dts/qcom/sdm845-google-blueline.dts  | 31 ++++++++++++++-----
 1 file changed, 24 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-google-blueline.dts b/arch/arm64/boot/dts/qcom/sdm845-google-blueline.dts
index e0dd41240045..c4be4c863116 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-google-blueline.dts
+++ b/arch/arm64/boot/dts/qcom/sdm845-google-blueline.dts
@@ -177,9 +177,9 @@ sde_pmgpio_suspend: sde_pmgpio_suspend {
 };
 
 &adsp_pas {
-	status = "disabled";
+	status = "okay";
 
-	firmware-name = "qcom/sdm845/pixel3/adsp.mbn";
+	firmware-name = "qcom/sdm845/pixel3/adsp.mdt";
 };
 
 &apps_rsc {
@@ -338,8 +338,8 @@ vreg_bob: bob {
 };
 
 &cdsp_pas {
-	status = "disabled";
-	firmware-name = "qcom/sdm845/pixel3/cdsp.mbn";
+	status = "okay";
+	firmware-name = "qcom/sdm845/pixel3/cdsp.mdt";
 };
 
 &gpi_dma0 {
@@ -374,7 +374,7 @@ st_fts@49 {
 		st,max-coords = <1079 2159>;
 		st,regulator_dvdd = "vdd";
 		st,regulator_avdd = "avdd";
-		/* todo  st,firmware_name = "ftm4_fw.ftb"; */
+		st,firmware_name = "qcom/sdm845/pixel3/ftm5_fw.ftb";
 	};
 };
 
@@ -562,6 +562,13 @@ bluetooth {
 		vddrf-supply = <&vreg_l17a_1p3>;
 		vddch0-supply = <&vreg_l25a_3p3>;
 		max-speed = <3200000>;
+		// qca/crbtfw21.tlv
+		// qca/qcom/sdm845/pixel/crnv21.bin direct load fails
+		//firmware-name = "qcom/sdm845/pixel3/crbtfw21.tlv";
+		//firmware-name = "qcom/sdm845/pixel3/crnv2.bin";
+		
+		// this one forces "qca/qcom" onto the front and our fw puts it there now
+		firmware-name = "crnv21.bin";
 	};
 };
 
@@ -689,16 +696,26 @@ pinconf-rx {
 	};
 };
 
+&gmu {
+	status = "okay";
+};
+
 &gpu {
+	status = "okay";
+
 	zap-shader {
 		memory-region = <&gpu_mem>;
-		firmware-name = "qcom/sdm845/pixel3/a630_zap.mbn";
+		firmware-name = "qcom/sdm845/pixel3/a630_zap.mdt";
 	};
 };
 
+&venus {
+	status = "okay";
+};
+
 &mss_pil {
 	status = "disabled";
-	firmware-name = "qcom/sdm845/pixel3/mba.mbn", "qcom/sdm845/pixel3/modem.mbn";
+	firmware-name = "qcom/sdm845/pixel3/mba.mbn", "qcom/sdm845/pixel3/modem.mdt";
 };
 
 &dsi0 {
-- 
